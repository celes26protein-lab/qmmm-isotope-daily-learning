#1000steps, 0.5ps
Short QM/MM MD, PM3
&cntrl
  imin=0, irest=0, ntx=1,
  nstlim=1000, dt=0.0005,
  ntt=3, gamma_ln=2.0, temp0=300.0, tempi=300.0, ig=12345,
  ntb=1, ntc=1, ntf=1, cut=8.0,
  ntpr=1, ntwx=1, ntwr=1000,
  ifqnt=1
/
&qmmm
  qmmask=':1-2', qmcharge=0,
  qm_theory='PM3', qmshake=0,
  qm_ewald=1, qm_pme=1
/
